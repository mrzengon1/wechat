# 复制为 .env 后填写
# 本项目使用 wxauto4，请登录微信 PC 4.1.x（推荐锁定 4.1.8.107）

# selected = 只回复名单内联系人
# all      = 回复所有有新消息的用户（可用 IGNORE 排除）
LISTEN_MODE=selected

# 指定联系人备注名，多个用顿号 、 分隔
TARGET_NICKNAMES=张三、李四

# all 模式要忽略的会话
IGNORE_NICKNAMES=文件传输助手,微信团队
# 群聊：true 时 all 模式回复群；selected 模式把群名写入白名单即可
REPLY_GROUP_CHATS=true
# 群聊：未 @ 我时的回复冷却（秒）；@ 我仍用 MIN_REPLY_INTERVAL
# GROUP_REPLY_INTERVAL=45
# 群聊：仅 @ 别人时不回复
# GROUP_SKIP_AT_OTHERS=true

# 是否读取历史消息（默认 true）
USE_CHAT_HISTORY=true
# 带入最近多少条微信对话（技术类自动用 WECHAT_CONTEXT_LIMIT_TECHNICAL）
# WECHAT_CONTEXT_LIMIT=24
# WECHAT_CONTEXT_LIMIT_TECHNICAL=48

# 最多取多少条「我」的历史发言（仅「模仿正常」风格使用，且只看当前会话）
TONE_SAMPLE_LIMIT=12
TONE_MIN_SELF=3

# 语音消息：自动转文字后按文字回复
ENABLE_VOICE=true

LLM_API_KEY=sk-你的密钥
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-v4-flash
# 关闭深度思考，加快微信回复（DeepSeek V4）
# 单条回复最大字数；0 表示不截断
# REPLY_MAX_CHARS=0
# MAX_TOKENS=256
# MAX_TOKENS_TECHNICAL=1024

# 文字 emoji（😂🙂，不随机追加）
ENABLE_EMOJI=true
EMOJI_PROB=0
EMOJI_MAX=1

# 可选：被问名字时可回答（留空则不编造、岔开话题）
# BOT_REAL_NAME=你的昵称

# 微信收藏表情包（对方发表情时回复）
ENABLE_STICKER=true
# 下标从 0 起，对应微信「表情-添加的表情」从左到右顺序
STICKER_INDEXES=0,1,2,3,4
STICKER_AFTER_TEXT_PROB=0
STICKER_REPLY_TO_EMOTION_PROB=0.5
STICKER_ONLY_PROB=0.25
# 默认风格（单一列表，不必再选性别）
# mimic模仿正常 gaoleng_yujie高冷御姐 wenrou温柔软妹 luoli软萌萝莉 yuanqi元气少女
# bazong霸道总裁 nuannan暖心暖男 pishuai痞帅少年 zhainan直球直男 chenwen沉稳大叔
PERSONA=mimic

# OpenAI 官方：
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini

# 本地 Ollama：
# LLM_API_KEY=ollama
# LLM_BASE_URL=http://127.0.0.1:11434/v1
# LLM_MODEL=qwen2.5:7b
